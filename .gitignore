# Secrets et environnements (jamais versionnés — voir .env.example / *.template)
.env
.env.*
!.env.example
outils/*/*.env

# Sources amont des OUTILS en sous-modules : le contenu vit dans le sous-module, pas ici
#   outils/<outil>/source  -> voir .gitmodules

# Cibles à scanner : jamais versionnées (dépôt agnostique). Elles sont clonées au lancement
# par scripts/bootstrap.sh dans cible/copies/<nom>. Tout cible/ est ignoré sauf ce fichier.
cible/*
!cible/.gitkeep

# Sorties d'outils, spécifiques à chaque lancement et à chaque cible : non historisées
outils/shannon/source/workspaces/
resultats/brut/
matrice/

# Configs Shannon remplies avec des identifiants : ne versionner que les *.template.yaml
# (les models.*.json, en .json, restent versionnés).
outils/shannon/configs/*.yaml
!outils/shannon/configs/*.template.yaml

# Codex Security : identité Codex et historique des scans (isolés de ~/.codex)
outils/codex-security/codex-home/
outils/codex-security/state/

# Artefacts laissés par Shannon dans la cible de fumée
outils/shannon/smoke-target/.shannon/
outils/shannon/smoke-target/.playwright/

credentials/
secrets/
*.key
*.pem

node_modules/
.DS_Store