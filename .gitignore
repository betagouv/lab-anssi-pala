# Secrets et environnements (jamais versionnés — voir .env.example / *.template)
.env
.env.*
!.env.example
outils/*/*.env
outils/outil-tiers/webui-static/

# Dépôts outillés en sous-modules : le contenu vit dans le sous-module, pas ici
#   cible/cible-exemple, outils/shannon/source, outils/outil-tiers/source  -> voir .gitmodules

# Copies de scan et sorties d'outils, spécifiques à chaque lancement et à chaque cible :
# non historisées (le dépôt vise à être rejoué sur d'autres projets)
cible/copies/
passerelles/outil-tiers-to-shannon/sarif-shannon/
outils/shannon/source/workspaces/
resultats/brut/
matrice/

# Configs Shannon remplies avec des identifiants : ne versionner que les *.template.yaml
outils/shannon/configs/config-cible-exemple-authentifie.yaml
outils/shannon/configs/config-cible-exemple-focus.yaml
outils/shannon/configs/config-cible-exemple-creation-compte.yaml
outils/shannon/configs/config-cible-exemple-sast.yaml

# Artefacts laissés par Shannon dans la cible de fumée
outils/shannon/smoke-target/.shannon/
outils/shannon/smoke-target/.playwright/

credentials/
secrets/
*.key
*.pem

node_modules/
.DS_Store