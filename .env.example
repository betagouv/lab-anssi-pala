#############################
#           PALA            #
#############################

FOURNISSEUR_NOM=# albert ou scaleway
FOURNISSEUR_BASE_URL=# ex. https://albert.api.etalab.gouv.fr/v1 ou https://api.scaleway.ai/<projet>/v1
FOURNISSEUR_API_KEY=# Clef d’API du fournisseur
FOURNISSEUR_MODELE=# Identifiant EXACT attendu par le fournisseur, namespace inclus (ex. openai/gpt-oss-120b, deepseek-ai/DeepSeek-V4-Flash-0731, deepseek-v4-flash-0731)
# Tarifs du modèle ($/token) — requis pour générer le model_list du proxy LiteLLM (budget).
# À garder alignés avec outils/codex-security/scripts/estimer-cout.py. Albert : 0 (gratuit).
FOURNISSEUR_COUT_ENTREE_PAR_TOKEN=# ex. 0 (Albert) ou 0.0000004 (Scaleway)
FOURNISSEUR_COUT_SORTIE_PAR_TOKEN=# ex. 0 (Albert) ou 0.0000008 (Scaleway)
# (Optionnels) paramètres d’échantillonnage et tool_choice imposés au proxy ; omis si absents.
# FOURNISSEUR_MAX_TOKENS=16384
# FOURNISSEUR_TEMPERATURE=1
# FOURNISSEUR_TOP_P=1
# FOURNISSEUR_PRESENCE_PENALTY=0
# FOURNISSEUR_TOOL_CHOICE=auto
MATTERMOST_URL=# (Optionnelle) URL du hook Mattermost pour poster les messages en fin de scan
LITELLM_API_KEY=# La clé d’API du proxy LITE LLM
LITELLM_BASE_URL=# L’URL du proxy LITE LLM
LITELLM_CHEMIN_FICHIER_CONFIGURATION=# Chemin vers le fichier dans lequel la configuration du proxy va être écrite
# Destinataires du rapport de scan chiffré (clés publiques X25519 issues de l’enrôlement).
# Format : [{"keyId":"<keyId>","clePublique":"<base64url>"}]
RAPPORT_DESTINATAIRES=[]

#############################
#          SERVEUR          #
#############################

NB_REQUETES_MAX_PAR_MINUTE=# rate limit à mettre en place
NB_REQUETES_MAX_PAR_MINUTE_ENDPOINT_SENSIBLE=# rate limit à mettre en place sur les endpoints sensibles

NB_REQUETES_TRUST_PROXY=# optionnel (0 par défaut) nombre de proxies en amont du service ou configuration plus fine de trust proxy, Cf.  https://expressjs.com/en/guide/behind-proxies.html

#############################
#             BDD           #
#############################

BASE_DONNEES_URL=# URL de la base de données
BASE_DE_DONNEES_MAX_POOL=# POOL maximum (10 par défaut)
BASE_DE_DONNEES_MIN_POOL=# POOL minimum (0 par défaut)

#############################
#           CELLAR          #
#############################

CELLAR_ACCESS_KEY_ID=# La clef d’accès au cellar
CELLAR_SECRET_ACCESS_KEY=# Le secret d’accès au cellar
CELLAR_NOM_DU_BUCKET=# Le nom du bucket cible
CELLAR_REGION=# Le nom de la région
CELLAR_URL=# L’URL du cellar