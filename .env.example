#############################
#           PALA            #
#############################

FOURNISSEUR_NOM=# albert ou scaleway
FOURNISSEUR_BASE_URL=# ex. https://albert.api.etalab.gouv.fr/v1 ou https://api.scaleway.ai/<projet>/v1
FOURNISSEUR_API_KEY=# Clef d’API du fournisseur
FOURNISSEUR_MODELE=# LLM sur lequel s’appuyer
MATTERMOST_URL=# (Optionnelle) URL du hook Mattermost pour poster les messages en fin de scan
LITELLM_API_KEY=# La clé d’API du proxy LITE LLM
LITELLM_BASE_URL=# L’URL du proxy LITE LLM

#############################
#          SERVEUR          #
#############################

NB_REQUETES_MAX_PAR_MINUTE=# rate limit à mettre en place
NB_REQUETES_MAX_PAR_MINUTE_ENDPOINT_SENSIBLE=# rate limit à mettre en place sur les endpoints sensibles

NB_REQUETES_TRUST_PROXY=# optionnel (0 par défaut) nombre de proxies en amont du service ou configuration plus fine de trust proxy, Cf.  https://expressjs.com/en/guide/behind-proxies.html

#############################
#             BDD           #
#############################

BASE_DONNEES_URL=# URL de la base de données
BASE_DE_DONNEES_MAX_POOL=# POOL maximum (10 par défaut)
BASE_DE_DONNEES_MIN_POOL=# POOL minimum (0 par défaut)