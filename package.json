{
  "name": "pala-outillage",
  "private": true,
  "description": "Outillage TypeScript du laboratoire d'audit (en parallèle des scripts bash/Python)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "estimer-cout": "node outillage/javascript/src/composition/estimer-cout.ts",
    "bootstrap": "node outillage/javascript/src/composition/bootstrap.ts",
    "format:corrige": "prettier --write .",
    "format:verifie": "prettier --check .",
    "generate-env": "node --require dotenv/config outillage/javascript/src/composition/generate-env.ts",
    "start-proxy": "node outillage/javascript/src/composition/start-proxy.ts",
    "scan": "DOTENV_CONFIG_PATH=outils/codex-security/codex-security.env node --require dotenv/config outillage/javascript/src/composition/scan.ts",
    "validate": "node outillage/javascript/src/composition/validate.ts",
    "shannon": "node --require dotenv/config outillage/javascript/src/composition/shannon.ts",
    "shannon-smoke": "node --require dotenv/config outillage/javascript/src/composition/shannon-smoke.ts",
    "check-tool-calls": "node --require dotenv/config outillage/javascript/src/composition/check-tool-calls.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
