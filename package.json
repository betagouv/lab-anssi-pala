{
  "name": "pala-outillage",
  "private": true,
  "description": "Outillage TypeScript du laboratoire d'audit (en parallèle des scripts bash/Python)",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:back": "node --require dotenv/config --watch --import tsx serveur/back/src/index.ts",
    "dev:front": "pnpm --dir serveur/front dev",
    "build": "pnpm build:back && pnpm build:front",
    "build:back": "tsc --noEmit",
    "build:front": "pnpm --dir serveur/front install && pnpm --dir serveur/front build",
    "start": "node --require dotenv/config serveur/back/src/index.ts",
    "format:corrige": "prettier --write .",
    "format:verifie": "prettier --check .",
    "pala:estimer-cout": "node outillage/src/composition/estimer-cout.ts",
    "pala:bootstrap": "node outillage/src/composition/bootstrap.ts",
    "pala:génère-env": "node --require dotenv/config outillage/src/composition/genere-env.ts",
    "pala:génère-config": "node --require dotenv/config outillage/src/composition/genere-config.ts",
    "codex:démarre-proxy": "node --require dotenv/config outillage/src/composition/demarre-proxy.ts",
    "codex:scan-complet": "node --require dotenv/config outillage/src/composition/scan-complet.ts",
    "codex:scan": "node --require dotenv/config outillage/src/composition/scan.ts",
    "codex:validate": "node outillage/src/composition/validate.ts",
    "shannon:pen-test": "node --require dotenv/config outillage/src/composition/shannon.ts",
    "shannon:smoke-test": "node --require dotenv/config outillage/src/composition/shannon-smoke.ts",
    "shannon:vérifie-appels-outils-llm": "node --require dotenv/config outillage/src/composition/verifie-appels-outils-llm.ts"
  },
  "runtimeDependencies": {
    "@lab-anssi/ui-kit": "1.64.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "express": "^5.3.0",
    "express-ip-filter": "^2.0.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lusca": "^1.7.5",
    "@types/node": "24.19.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
